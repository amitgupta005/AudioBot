# Server
PORT=4001
NODE_ENV=development

# FastAPI backend URL
FASTAPI_URL=http://localhost:8000

# JWT
JWT_SECRET=change-this-super-secret-jwt-key-in-production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-this-refresh-secret-in-production
JWT_REFRESH_EXPIRES_IN=30d

# MongoDB
MONGODB_URI=mongodb://localhost:2000

# Redis
REDIS_URL=redis://localhost:6379
SESSION_TTL=3600

# Admin seed credentials
ADMIN_EMAIL=admin@audiobot.com
ADMIN_PASSWORD=Admin@123!

# CORS — frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:2000
