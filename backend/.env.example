# =============================================================================
# AudioBot Backend — Environment Variables
# =============================================================================
# Copy this file to .env and fill in real values for your deployment.
# NEVER commit the actual .env file to version control.
# =============================================================================

# --- LLM Provider ---
VERTEX_AI_PROJECT=audio-493721
VERTEX_AI_LOCATION=us-central1
VERTEX_AI_MODEL_CHAT=gemini-1.5-flash
VERTEX_AI_MODEL_REASONING=gemini-1.5-pro

# --- LangSmith Observability (optional) ---
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your-langsmith-api-key-here
LANGSMITH_PROJECT=HR Audiobot

# --- STT Provider ---
GROQ_API_KEY=your-groq-api-key-here

# --- Database (Supabase) ---
DATABASE_URL=postgresql://postgres.[project-ref]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres


# --- Security ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- Application ---
ENVIRONMENT=development
CORS_ALLOW_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_CREDENTIALS=true
MOCK_INTERVIEW_COMPANY_NAME=Noventra Practice Lab

# --- Reports ---
# REPORTS_DIR=./generated_reports
