# The Black Hole (This is 99% likely what was freezing your build)
node_modules/

# Build outputs (Docker should build these itself, not copy your local ones)
dist/
build/
.next/
out/

# NPM/Yarn logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Environment variables (Security)
.env
.env.local
.env.development

# Git history
.git/
.gitignore

# Docker files
Dockerfile
.dockerignore

# AudioBot specific data (Prevents uploading local test audio/DBs)
*.mp3
*.wav
*.flac